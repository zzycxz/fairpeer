# Copy to .env and fill in. Only secrets belong here — a provider's base_url and
# model are configured in fairpeer.toml, where api_key_env points at these variables.

# ── Required ──────────────────────────────────────────────────────────────────
JIUTIAN_API_KEY=          # MoMA (九天) platform API key — the default provider

# ── Optional: other providers ─────────────────────────────────────────────────
# ANTHROPIC_API_KEY=      # Anthropic (Claude) — used by `fairpeer setup` anthropic flow
# OPENAI_API_KEY=         # OpenAI or compatible endpoints

# ── Optional: Bot channels (QQ / 飞书 / 微信) ─────────────────────────────────
# QQ_BOT_APP_SECRET=      # QQ Bot app secret
# FEISHU_BOT_APP_SECRET=  # 飞书 Bot app secret
# WEIXIN_BOT_TOKEN=       # 微信 Bot token
